# ============================================
# Multi-Agent Research Assistant - Environment Variables
# ============================================
# Copy this file and rename it to .env
# Then fill in your actual API keys
#
# BOTH keys are FREE to get:
#
# 1. Google Gemini API Key (for Summarizer Agent):
#    → Go to https://aistudio.google.com/apikey
#    → Sign in with your Google account
#    → Click "Create API Key"
#    → Copy and paste below
#
# 2. Groq API Key (for Report Writer Agent):
#    → Go to https://console.groq.com/keys
#    → Sign up (free account)
#    → Click "Create API Key"
#    → Copy and paste below
# ============================================

GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here
